{
  "name": "genome-modernization",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4191",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4191",
    "test": "vitest run src/_tests_",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "presets:check": "node scripts/check-preset-sources.mjs",
    "test:e2e:production": "npm run build && GENOME_TEST_PRODUCTION=1 playwright test"
  },
  "dependencies": {
    "chroma-js": "2.4.2",
    "color-convert": "2.0.1",
    "delta-e": "0.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/chroma-js": "2.4.4",
    "@types/node": "22.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
